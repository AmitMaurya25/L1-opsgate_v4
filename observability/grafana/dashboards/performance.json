 "templating": {
  "list": [
   {
    "name": "route",
    "label": "Route",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "opsgate-prom"
    },
    "query": {
     "query": "label_values(opsgate_turns_total,route)",
     "refId": "v"
    },
    "refresh": 2,
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    }
   },
   {
    "name": "source",
