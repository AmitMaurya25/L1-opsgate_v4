{
 "uid": "opsgate-perf",
 "title": "OpsGate | Agent Performance (staff only)",
 "tags": [
  "opsgate",
  "staff-only"
 ],
 "timezone": "browser",
 "refresh": "10s",
 "schemaVersion": 39,
 "editable": false,
 "graphTooltip": 1,
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Overview - click a route in the bar chart to drill down; use the variables above to filter",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Handled turns",
   "description": "All chat turns, including blocked ones.",
   "datasource": {
    "type": "prometheus",
    "uid": "opsgate-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "opsgate-prom"
     },
     "expr": "sum(increase(opsgate_turns_total{route=~\"$route\"}[$__range]))",
     "legendFormat": "",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "graphMode": "area",
    "colorMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Resolution confirmations",
   "description": "Explicit user \"resolved\" confirmations / answered (RAG+tools) turns. Not a measured L1 resolution rate.",
   "datasource": {
    "type": "prometheus",
    "uid": "opsgate-prom"
   },
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "opsgate-prom"
     },
     "expr": "100*(sum(increase(opsgate_resolved_total{route=~\"$route\"}[$__range])))/clamp_min(sum(increase(opsgate_turns_total{route=~\"rag|tools\"}[$__range])),1)",
     "legendFormat": "",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Escalation rate",
   "description": "HITL turns / all turns.",
   "datasource": {
    "type": "prometheus",
    "uid": "opsgate-prom"
